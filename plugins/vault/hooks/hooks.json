{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "uvx notes-vault-mcp==0.8.0 hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx notes-vault-mcp==0.8.0 hook stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
